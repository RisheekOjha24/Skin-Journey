# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- Database ----
# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./data/skin-journey.db

# ---- Auth ----
# Use a long, random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-random-secret-at-least-16-characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- YouCam / Perfect Corp API ----
# Get your API key from the Perfect Corp YouCam Developer Console
# (yce.perfectcorp.com/api-console) after redeeming your hackathon code.
# V2 auth is a plain Bearer token — no separate auth call is needed.
# Leave YOUCAM_MOCK_MODE=true to run the full app with deterministic
# mock scan data before you have a live key.
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_API_KEY=your-youcam-api-key
YOUCAM_CLIENT_ID=
YOUCAM_MOCK_MODE=true

# Timeout (ms) for all outbound Axios calls to third-party APIs (YouCam, etc.)
EXTERNAL_API_TIMEOUT_MS=20000

# ---- Google Gemini (AI progress summaries) ----
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=8
